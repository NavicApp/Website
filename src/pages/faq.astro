---
import Disclosure from "@components/controls/Disclosure.astro"
import Layout from "@layouts/MainLayout.astro"
const mainEntity = [
	{
		"@type": "Question",
		"name": "Is Navic free?",
		"acceptedAnswer": {
			"@type": "Answer",
			"text": "Navic is completely free and open source."
		}
	},
	{
		"@type": "Question",
		"name": "Is Navic stable?",
		"acceptedAnswer": {
			"@type": "Answer",
			"text": "Navic is not yet stable and is in a pre-release alpha state. However, most things should work just fine!"
		}
	},
	{
		"@type": "Question",
		"name": "Why Navic over other Subsonic clients?",
		"acceptedAnswer": {
			"@type": "Answer",
			"text": "Most Subsonic clients are closed source. This project was started in hopes of making an open and free alternative. Additionally, most clients just simply don't look very pretty, and we wanted to fix all of this. Navic is also native, making it one of the faster and efficient clients. It uses Compose and Kotlin."
		}
	},
	{
		"@type": "Question",
		"name": "Does Navic work with other streaming services?",
		"acceptedAnswer": {
			"@type": "Answer",
			"text": "For now, no. However, some plugins for other services have been made to add compatibility with Subsonic clients."
		}
	}
]
---

<Layout
	title="Frequently Asked Questions"
	description="Answers to frequently asked questions about Navic"
	type="FAQPage"
	mainEntity={mainEntity}
>
	<div class="page-content">
		<h2>Frequently Asked Questions</h2>
		<span style="text-align: center;">Some answers to common questions about Navic.</span>
		{
			mainEntity.map(qa => (
				<Disclosure
					title={qa.name}
					description={qa.acceptedAnswer.text}
				/>
			))
		}
	</div>
</Layout>

<style>
	h2 {
		margin-bottom: 0;
		text-align: center;
	}
	.page-content {
		margin: auto;
		max-width: 800px;
		margin-top: 70px;
		margin-bottom: 70px;
		padding-left: 24px;
		padding-right: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
</style>
